updates.kodework.dev {
  encode zstd gzip
  root * /srv/kodework-updates
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  @manifest path /stable/latest.json
  header @manifest Cache-Control "public, max-age=300, must-revalidate"
  @artifacts path_regexp artifacts ^/stable/.*\.(msi|sig)$
  header @artifacts Cache-Control "public, max-age=31536000, immutable"
  file_server
}
